{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.localloom.com.au/api/v1",
        "EXPO_PUBLIC_SOCKET_BASE_URL": "https://api.localloom.com.au"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.localloom.com.au/api/v1",
        "EXPO_PUBLIC_SOCKET_BASE_URL": "https://api.localloom.com.au"
      }
    },
    "production": {
      "android": {
        "buildType": "aab"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.localloom.com.au/api/v1",
        "EXPO_PUBLIC_SOCKET_BASE_URL": "https://api.localloom.com.au"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
